# Copia este archivo como .env y completa los valores (Supabase > Project Settings > API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública "anon" o "publishable". NUNCA pongas aquí la service_role/secret key.
SUPABASE_ANON_KEY=tu-anon-key
# Solo si tu proyecto usa la clave JWT legacy (HS256). Proyectos nuevos: déjalo vacío.
SUPABASE_JWT_SECRET=
JWT_AUDIENCE=authenticated
# Orígenes del frontend permitidos, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081
# URL del servidor Ollama y nombre del modelo local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
